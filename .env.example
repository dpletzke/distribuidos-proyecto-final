# PostgreSQL; Compose usa estas credenciales para ambos contenedores.
POSTGRES_DB=PetAlert
POSTGRES_USER=petalert_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
# Ejecucion Node directa: ajustar host a localhost y puerto a 5433.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=PetAlert
DB_USER=petalert_user
DB_PASSWORD=change_me
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5

# pgAdmin web (clave independiente del usuario PostgreSQL)
PGADMIN_EMAIL=admin@petalert.com
PGADMIN_PASSWORD=change_me_pgadmin
PGADMIN_PORT=5050

# ProteccionAnimal reutiliza POSTGRES_USER/PASSWORD y el puerto PostgreSQL anterior.
DENUNCIAS_PORT=3001
