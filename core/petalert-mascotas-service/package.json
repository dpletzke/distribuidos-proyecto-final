{
  "name": "petalert-mascotas-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:unit": "tsx --test tests/validation.test.ts",
    "artifacts": "tsx scripts/generate-artifacts.ts"
  },
  "dependencies": {
    "cors": "^2.8.5", "dotenv": "^17.2.3", "express": "^5.1.0",
    "helmet": "^8.1.0", "multer": "^2.0.2", "pg": "^8.16.3",
    "sharp": "^0.34.5", "swagger-ui-express": "^5.0.1", "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19", "@types/express": "^5.0.5", "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0", "@types/pg": "^8.15.6", "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.6", "typescript": "^5.9.3"
  }
}
