{
  "openapi": "3.0.3",
  "info": {
    "title": "PetAlert Mascotas",
    "version": "1.0.0",
    "description": "API local sin autenticación. Registro, consulta, listado y borrado persistentes, códigos GPS únicos y fotografías de hasta 5 MB."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor actual"
    }
  ],
  "components": {
    "schemas": {
      "MascotaCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nombre",
          "raza",
          "color"
        ],
        "properties": {
          "coordenadas": {
            "type": "object",
            "nullable": true,
            "additionalProperties": false,
            "required": [
              "latitud",
              "longitud"
            ],
            "description": "Ubicacion WGS84 en grados decimales; null si no se conoce.",
            "properties": {
              "latitud": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitud": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "example": {
              "latitud": 6.2442,
              "longitud": -75.5812
            }
          },
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Max"
          },
          "raza": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Labrador"
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Dorado"
          },
          "collar_gps": {
            "type": "string",
            "nullable": true,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$",
            "example": "CO-458",
            "description": "Se recortan espacios externos y se convierte a mayúsculas. Único; múltiples NULL permitidos."
          },
          "foto": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "maxLength": 2048,
            "example": null,
            "description": "URL HTTP/HTTPS externa o null. Para adjuntar archivo use multipart/form-data en el registro."
          }
        }
      },
      "Mascota": {
        "type": "object",
        "required": [
          "id",
          "coordenadas",
          "nombre",
          "raza",
          "color",
          "collar_gps",
          "foto",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "coordenadas": {
            "type": "object",
            "nullable": true,
            "additionalProperties": false,
            "required": [
              "latitud",
              "longitud"
            ],
            "description": "Ubicacion WGS84 en grados decimales; null si no se conoce.",
            "properties": {
              "latitud": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitud": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "example": {
              "latitud": 6.2442,
              "longitud": -75.5812
            }
          },
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Max"
          },
          "raza": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Labrador"
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Dorado"
          },
          "collar_gps": {
            "type": "string",
            "nullable": true,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$",
            "example": "CO-458",
            "description": "Se recortan espacios externos y se convierte a mayúsculas. Único; múltiples NULL permitidos."
          },
          "foto": {
            "type": "string",
            "nullable": true,
            "example": "/uploads/mascota-uuid.png"
          },
          "id": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            ],
            "description": "Número mientras sea seguro en JavaScript; cadena para BIGINT superior a 2^53-1.",
            "example": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Verificar conexión PostgreSQL",
        "responses": {
          "200": {
            "description": "Disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "status": "OK",
                  "service": "petalert-mascotas-service",
                  "database": "connected"
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mascotas": {
      "get": {
        "operationId": "listarMascotas",
        "summary": "Listar todas las mascotas por ID ascendente",
        "responses": {
          "200": {
            "description": "Lista completa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Mascota"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "crearMascota",
        "summary": "Registrar mascota",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MascotaCreate"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nombre",
                  "raza",
                  "color"
                ],
                "properties": {
                  "coordenadas": {
                    "type": "string",
                    "example": "{\"latitud\":6.2442,\"longitud\":-75.5812}",
                    "description": "JSON como texto; opcional. Omitir o enviar null para ubicacion desconocida."
                  },
                  "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "Max"
                  },
                  "raza": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "Labrador"
                  },
                  "color": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "Dorado"
                  },
                  "collar_gps": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Opcional; omitir si no tiene GPS. No enviar vacio ni la cadena null."
                  },
                  "foto": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo opcional JPG/PNG/WEBP, maximo 5 MB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Mascota con campos de auditoría",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mascota"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "codigo": "DATOS_INVALIDOS",
                  "mensaje": "nombre: campo obligatorio"
                }
              }
            }
          },
          "404": {
            "description": "Mascota o recurso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "GPS ya asignado a otra mascota",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "codigo": "GPS_DUPLICADO",
                  "mensaje": "El código del collar GPS CO-458 ya se encuentra registrado en otra mascota."
                }
              }
            }
          },
          "413": {
            "description": "Archivo mayor de 5 MB o JSON mayor de 64 KB",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Tipo de fotografía inválido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Base de datos no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "codigo",
                    "mensaje"
                  ],
                  "properties": {
                    "codigo": {
                      "type": "string"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/mascotas/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "example": "1"
          },
          "description": "BIGINT positivo hasta 9223372036854775807"
        }
      ],
